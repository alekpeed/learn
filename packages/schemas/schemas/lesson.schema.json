{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.local/schemas/lesson.schema.json",
  "title": "Lesson",
  "description": "Standard lesson components (doc 06 §2). Ordered components rendered one primary task at a time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lesson_id", "skill_id", "title", "components", "content_version"],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.lesson$"
    },
    "skill_id": { "$ref": "common.schema.json#/$defs/skillId" },
    "title": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "body"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "learning_objective",
              "prerequisite_reminder",
              "intuitive_explanation",
              "representation",
              "formal_terminology",
              "worked_example",
              "guided_practice",
              "independent_practice",
              "transfer_problem",
              "common_mistakes",
              "summary",
              "review_prompt"
            ]
          },
          "body": { "type": "string", "minLength": 1 },
          "accessible_text": { "$ref": "common.schema.json#/$defs/accessibleText" },
          "media_ref": { "type": "string" }
        }
      }
    },
    "content_version": { "$ref": "common.schema.json#/$defs/semver" }
  }
}
