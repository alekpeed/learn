{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.local/schemas/course.schema.json",
  "title": "Course",
  "type": "object",
  "additionalProperties": false,
  "required": ["course_id", "subject_id", "title", "version", "status", "units"],
  "properties": {
    "course_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "subject_id": { "$ref": "common.schema.json#/$defs/subjectId" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "status": { "type": "string", "enum": ["draft", "published", "retired"] },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "title", "order"],
        "properties": {
          "unit_id": { "$ref": "common.schema.json#/$defs/unitId" },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
