# Externalized configuration (doc 15 §2). Copy to .env and adjust.
# The MVP client is a static, local-first SPA and needs NO secrets to run.
# These become relevant when a real AI provider or cloud sync is added later.

# --- AI tutor (optional; off by default, DEC-010) ---
# Provider credentials MUST live server-side, never in the client bundle
# (doc 08 §7). Set these on the AI-gateway service, not the client.
# AI_PROVIDER=stub
# AI_MODEL=
# AI_PROVIDER_API_KEY=

# --- Logging ---
# LOG_LEVEL=info

# --- Content package source (doc 15 §2) ---
# CONTENT_PACKAGE=bundled
